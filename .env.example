# Copy to .env (never commit .env) or set these in your hosting dashboard.

# Signs the session cookie. Optional: if unset, a random key is generated and kept in DATA_DIR.
# Set it explicitly if you run more than one server process. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Where uploads, generated files and visitor data are kept (default: ./instance)
# DATA_DIR=/tmp/notegenius

# Limits
# MAX_UPLOAD_MB=15
# MAX_TEXT_CHARS=120000
# FILE_TTL_MINUTES=60

# Set to 1 when the site is served over HTTPS
# COOKIE_SECURE=1

# Optional Google web results in "Study resources" (create these in Google Cloud / Programmable Search Engine)
# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=

# Optional neural models (need requirements-ml.txt)
# SUMMARY_BACKEND=transformer      # default: extractive (fast, no model)
# QA_BACKEND=search                # force the lightweight sentence-matching answers
# QA_MODEL=deepset/tinyroberta-squad2
